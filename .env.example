# Merchant payTo wallet (Algorand MainNet address) — REQUIRED for real settlements
# Also accepted as AVM_ADDRESS for GoPlausible middleware compatibility
X402_PAY_TO=
AVM_ADDRESS=

# Price in USDC (human units). Default $0.01 → 10000 atomic (6 decimals)
X402_PRICE_USDC=0.01

# Network & asset (MainNet defaults for Global x402 Challenge)
ALGORAND_NETWORK=mainnet
USDC_ASA=31566704
# CAIP-2 (optional override): algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8=

# GoPlausible facilitator (verify + settle)
FACILITATOR_URL=https://facilitator.goplausible.xyz
GOPLAUSIBLE_FACILITATOR_URL=https://facilitator.goplausible.xyz

# Challenge attribution (must appear in paymentRequirements.extra.tag)
X402_CHALLENGE_TAG=x402-global-challenge

# Local / CI only: accept header X-PAYMENT: mock without on-chain settle
ALLOW_MOCK_PAYMENT=false

# Server
PORT=4021
HOST=0.0.0.0
NODE_ENV=development

# Optional merchant identity (Bazaar / x402-merchant extension)
MERCHANT_NAME=metaCAMPUS Credential Verify
MERCHANT_WEBSITE=https://metacampus.org
MERCHANT_LOGO=
MERCHANT_CATEGORIES=api,algorand,x402,credentials,education
