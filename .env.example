# Merchant payTo wallet — REQUIRED for real settlements (public address, not a private key)
# X402_PAY_TO=I4ZBH6RZRTFQN6DSTYJESIGK4VPSMDTXSXJEYEVBADVDQFSOQR4OV55BVE
X402_PAY_TO=
AVM_ADDRESS=

# Price in USDC (human units). Default $0.01 → 10000 atomic (6 decimals)
X402_PRICE_USDC=0.01

# Primary network (single-path). mainnet | testnet
ALGORAND_NETWORK=mainnet
USDC_ASA=31566704
# Optional CAIP-2 override:
# ALGORAND_CAIP2=algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8=

# Dual-path: also accept TestNet USDC in the same 402 (off on production MainNet)
# ENABLE_TESTNET_PATH=true
# X402_TESTNET_PAY_TO=I4ZBH6RZRTFQN6DSTYJESIGK4VPSMDTXSXJEYEVBADVDQFSOQR4OV55BVE
ENABLE_TESTNET_PATH=false
X402_TESTNET_PAY_TO=

# TestNet pilot mC ASA (transfer-intent metadata only — not a payment asset)
MC_ASA_ID=773957514

# GoPlausible facilitator (verify + settle)
FACILITATOR_URL=https://facilitator.goplausible.xyz
GOPLAUSIBLE_FACILITATOR_URL=https://facilitator.goplausible.xyz

X402_CHALLENGE_TAG=x402-global-challenge
ALLOW_MOCK_PAYMENT=false

PORT=4021
HOST=0.0.0.0
NODE_ENV=development

MERCHANT_NAME=metaCAMPUS Credential Verify
MERCHANT_WEBSITE=https://metacampus-on-algorand.grok.me
MERCHANT_LOGO=
MERCHANT_CATEGORIES=api,algorand,x402,credentials,education,mc

# --- Vercel ---
# Production (MainNet): X402_PAY_TO set, ENABLE_TESTNET_PATH=false
# Preview dual-path: ENABLE_TESTNET_PATH=true + X402_TESTNET_PAY_TO
# TestNet-only host: ALGORAND_NETWORK=testnet, USDC_ASA=10458941, X402_PAY_TO set
