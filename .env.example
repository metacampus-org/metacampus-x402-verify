# Merchant payTo wallet (Algorand MainNet address) — REQUIRED for real settlements
# Public receive address (not a private key). Also accepted as AVM_ADDRESS.
# Example (metaCAMPUS challenge merchant):
# X402_PAY_TO=I4ZBH6RZRTFQN6DSTYJESIGK4VPSMDTXSXJEYEVBADVDQFSOQR4OV55BVE
X402_PAY_TO=
AVM_ADDRESS=

# Price in USDC (human units). Default $0.01 → 10000 atomic (6 decimals)
X402_PRICE_USDC=0.01

# Network & asset (MainNet defaults for Global x402 Challenge)
ALGORAND_NETWORK=mainnet
USDC_ASA=31566704
# CAIP-2 (optional override): algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8=

# GoPlausible facilitator (verify + settle)
FACILITATOR_URL=https://facilitator.goplausible.xyz
GOPLAUSIBLE_FACILITATOR_URL=https://facilitator.goplausible.xyz

# Challenge attribution (must appear in paymentRequirements.extra.tag)
X402_CHALLENGE_TAG=x402-global-challenge

# Local / CI only: accept header X-PAYMENT: mock without on-chain settle
# Production (Vercel): must be false
ALLOW_MOCK_PAYMENT=false

# Server (ignored on Vercel Fluid Functions; used by Docker / npm start)
PORT=4021
HOST=0.0.0.0
NODE_ENV=development

# Optional merchant identity (Bazaar / x402-merchant extension)
MERCHANT_NAME=metaCAMPUS Credential Verify
# Marketing site (not the API host): https://metacampus-on-algorand.grok.me
MERCHANT_WEBSITE=https://metacampus-on-algorand.grok.me
MERCHANT_LOGO=
MERCHANT_CATEGORIES=api,algorand,x402,credentials,education

# --- Vercel production env (Project → Settings → Environment Variables) ---
# Required: X402_PAY_TO=<MainNet merchant address>
# Recommended: ALLOW_MOCK_PAYMENT=false
# Optional: X402_PRICE_USDC, FACILITATOR_URL, X402_CHALLENGE_TAG, MERCHANT_*
# Do NOT set private keys / mnemonics — settle goes through GoPlausible.
# After deploy: curl -i -X POST https://<vercel-host>/v1/credential/verify \
#   -H 'content-type: application/json' -d '{"hash":"a1b2c3d4e5f6789012345678abcdef01"}'
# Expect HTTP 402 with x402 paymentRequirements (tag x402-global-challenge).

# --- TestNet path only (Preview). Do NOT set on Production. ---
# Public TestNet receive address, opted into USDC ASA 10458941.
# Must NOT be the MainNet payTo. Never put a private key or mnemonic here.
# X402_TESTNET_PAY_TO=
# Route when set: POST /v1/testnet/credential/verify
# Network: algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
# Asset: 10458941 (TestNet USDC). Facilitator stays https://facilitator.goplausible.xyz
