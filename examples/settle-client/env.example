# Buyer signer — NEVER commit real values. Copy to .env locally.
#
# Option A (preferred for CLI): 88-char base64 (32-byte seed + 32-byte pubkey)
# AVM_PRIVATE_KEY=
#
# Option B: 25-word Algorand mnemonic (converted locally; never logged)
# AVM_MNEMONIC=

# Target paid API (default = live Hobby verify)
# VERIFY_URL=https://metacampus-x402-verify.vercel.app/v1/credential/verify

# Optional credential hash (hex). Default is the README example hash.
# CREDENTIAL_HASH=a1b2c3d4e5f6789012345678abcdef01
